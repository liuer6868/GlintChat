# ===========================================================================
# GlintChat 后端环境变量
# 复制本文件为 .env 后填入真实值：copy .env.example .env
# 绝对不要把 .env 提交到 git（已在 .gitignore 中忽略）
#
# 提示：值建议不加引号。dotenv 不会剥离引号，虽然本项目会自动清洗一次，
#       但不加引号更不容易出错。本文件保持纯 ASCII，便于 Windows 工具读取。
# ===========================================================================

# 服务监听端口
PORT=3000

# ---- 默认（全局）服务商配置 ----------------------------------------------
# 任何 OpenAI 兼容服务均可：DeepSeek、OpenAI、硅基流动、智谱、百炼、
# OpenRouter、各类中转站，以及本地 Ollama / LM Studio / vLLM
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1

# ---- 不知道怎么填？先体检一下 --------------------------------------------
#   node scripts/api-check.mjs --list-presets
#   node scripts/api-check.mjs --preset zhipu --key <你的Key>
#   node scripts/api-check.mjs --base http://127.0.0.1:11434/v1 --key ollama
# 体检会验证 /models、非流式对话、流式 SSE，并直接打印可粘贴的配置

# ---- 可选：按模型覆盖 baseURL / API Key ----------------------------------
# 变量名规则：MODEL_<模型ID大写，非字母数字替换为下划线>_BASE_URL / _API_KEY
# 例如 gpt-4o-mini -> MODEL_GPT_4O_MINI_BASE_URL
# MODEL_GPT_4O_MINI_BASE_URL=https://api.openai.com/v1
# MODEL_GPT_4O_MINI_API_KEY=sk-...

# ---- 可选：自定义模型清单（JSON 数组，整体覆盖内置清单）------------------
# 每项字段：id(必填) name(必填) description? provider? reasoning? baseUrlEnv? apiKeyEnv?
# MODELS_JSON=[{"id":"deepseek-chat","name":"DeepSeek-V3 (通用)","description":"通用对话模型","provider":"DeepSeek","reasoning":false}]

# ---- 可选：上游与网络行为 ------------------------------------------------
# 上游请求超时（毫秒），0 表示不限制
UPSTREAM_TIMEOUT_MS=120000
# SSE 心跳间隔（毫秒），防止中间代理掐断空闲连接
SSE_HEARTBEAT_MS=15000
# 允许跨域的前端来源（逗号分隔）；本地开发默认放行 localhost / 127.0.0.1 任意端口
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
